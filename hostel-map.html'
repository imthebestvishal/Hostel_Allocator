<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Hostel Room Explorer</title>

    <link rel="stylesheet" href="hostel-map.css">
</head>

<body>

    <!-- HEADER -->

    <header class="map-header">

        <div class="logo-section">
            <h1>🏢 Hostel Explorer</h1>

            <p>Explore rooms, floors and hostel facilities</p>
        </div>

        <button class="back-btn" onclick="goBack()">
            ← Back
        </button>

    </header>


    <!-- MAIN CONTAINER -->

    <main class="map-container">


        <!-- HOSTEL AND FLOOR SELECTORS -->

        <section class="controls-section">

            <div class="selector-box">

                <label for="hostelSelect">
                    Select Hostel
                </label>

                <select id="hostelSelect">

                    <option value="boys">
                        Boys Hostel
                    </option>

                    <option value="girls">
                        Girls Hostel
                    </option>

                </select>

            </div>


            <div class="selector-box">

                <label for="floorSelect">
                    Select Floor
                </label>

                <select id="floorSelect">

                    <option value="0">
                        Ground Floor
                    </option>

                    <option value="1">
                        1st Floor
                    </option>

                    <option value="2">
                        2nd Floor
                    </option>

                    <option value="3">
                        3rd Floor
                    </option>

                    <option value="4">
                        4th Floor
                    </option>

                    <option value="5">
                        5th Floor
                    </option>

                    <option value="6">
                        6th Floor
                    </option>

                </select>

            </div>

        </section>


        <!-- CURRENT SELECTION -->

        <section class="map-title">

            <h2 id="currentHostel">
                Boys Hostel
            </h2>

            <p id="currentFloor">
                Ground Floor
            </p>

        </section>


        <!-- HOSTEL MAP -->

        <section class="hostel-map">

            <div class="floor-label">
                <span id="floorDisplay">
                    Ground Floor
                </span>
            </div>


            <!-- ROOMS WILL BE CREATED BY JAVASCRIPT -->

            <div id="roomsContainer" class="rooms-container">

            </div>

        </section>

    </main>


    <!-- ROOM INFORMATION MODAL -->

    <div id="roomModal" class="modal">

        <div class="modal-content">

            <span
                class="close-btn"
                onclick="closeRoomModal()"
            >
                &times;
            </span>


            <h2 id="modalRoomNumber">
                Room 101
            </h2>


            <div class="room-info">

                <p>
                    <strong>Hostel:</strong>
                    <span id="modalHostel"></span>
                </p>


                <p>
                    <strong>Floor:</strong>
                    <span id="modalFloor"></span>
                </p>


                <p>
                    <strong>Occupancy:</strong>
                    <span id="modalOccupancy"></span>
                </p>


                <p>
                    <strong>Availability:</strong>
                    <span id="modalAvailability"></span>
                </p>

            </div>


            <!-- VIRTUAL TOUR DROPDOWN -->

            <button
                id="tourToggle"
                class="tour-toggle"
                onclick="toggleVirtualTour()"
            >
                🌐 Explore Virtual Tour ▼
            </button>


            <div
                id="virtualTourContainer"
                class="virtual-tour-container"
            >

                <iframe
                    id="tour-embedded"
                    title="Hostel Tour"
                    src="https://tour.panoee.net/iframe/hostel-tour-26?embedFullscreen=1&embedVr=1&embedGyro=1"
                    frameborder="0"
                    width="100%"
                    height="500"
                    scrolling="no"
                    allow="autoplay; accelerometer; gyroscope; fullscreen; xr-spatial-tracking"
                    loading="lazy"
                    allowfullscreen>
                </iframe>

            </div>

        </div>

    </div>


    <script src="hostel-map.js"></script>

</body>
</html>